<template>
  <view class="page">
    <!-- 顶部返回栏（nvue 无 CSS 变量 safe-area，必须显式按状态栏高度留白） -->
    <view class="navbar" :style="{ paddingTop: statusBarH + 'px' }">
      <text class="nav-back" @tap="goBack">‹</text>
      <text class="nav-title" lines="1">{{ video?.title || '视频详情' }}</text>
      <text class="nav-more" @tap="onMore">⋯</text>
    </view>

    <!-- 播放器（nvue 原生渲染：video + view 弹幕层 + 自定义控制条） -->
    <!-- 全屏时不给 inline height：CSS .player-fs 用 100% 跟随锁横屏后的视口 -->
    <view
      class="player"
      :class="{ 'player-fs': fullscreen }"
      :style="fullscreen ? {} : { width: screenW + 'px', height: playerH + 'px' }"
      @tap="onPlayerTap"
    >
      <video
        v-if="video"
        :id="'vd-' + video.id"
        :src="playUrl"
        :poster="video.cover_url"
        :controls="false"
        :show-center-play-btn="false"
        object-fit="contain"
        :style="fullscreen ? {} : { width: screenW + 'px', height: playerH + 'px' }"
        @play="onPlay"
        @pause="onPause"
        @timeupdate="onTimeUpdate"
        @ended="onEnded"
        @loadedmetadata="onLoadedMeta"
        class="video-el"
      />
      <!-- 透明触摸层：weex 的 video 原生组件不向父级冒泡 tap，必须靠这一层接收单击/双击手势 -->
      <view class="touch-layer" @tap="onPlayerTap" />
      <!-- 弹幕层（原生 view 模拟，绝对定位 + translateX 移动，触摸穿透） -->
      <view class="dm-layer">
        <view
          v-for="d in dmItems"
          :key="d.id"
          class="dm-item"
          :style="{
            transform: 'translateX(' + d.x + 'px)',
            top: d.y + 'px',
            color: d.color,
            fontSize: d.fontSize + 'px'
          }"
        >
          <text :style="{ color: d.color, fontSize: d.fontSize + 'px' }">{{ d.text }}</text>
        </view>
      </view>
      <!-- 封面遮罩：透明背景 + 中央播放按钮（B 站风格，不遮挡画面） -->
      <view v-if="!playing && !userStarted" class="cover" @tap.stop="onTogglePlay">
        <view class="play-btn"><text>▶</text></view>
        <text class="cover-tip">点击播放</text>
      </view>
      <!-- 控制条（B 站风格 PC 端功能：播放/暂停 + 时间 + 进度 + 弹幕开关 + 倍速菜单 + 循环 + 宽屏 + 音量 + 全屏） -->
      <view v-if="userStarted && controlsVisible" class="controls" @tap.stop="noop">
        <view class="ctrl-row">
          <view class="ctrl-btn" @tap="onTogglePlay">
            <text>{{ playing ? '❚❚' : '▶' }}</text>
          </view>
          <text class="ctrl-time">{{ formatClock(currentTime) }} / {{ formatClock(duration) }}</text>
          <view class="spacer" />
          <!-- 弹幕开关 -->
          <view class="ctrl-btn" @tap="toggleDmVisible">
            <text>{{ dmVisible ? '弹' : '关弹' }}</text>
          </view>
          <!-- 倍速菜单（点击弹层选择） -->
          <view class="ctrl-btn" @tap="openSpeedMenu">
            <text>{{ speedLabel }}</text>
          </view>
          <!-- 循环 -->
          <view class="ctrl-btn" @tap="toggleLoop">
            <text>{{ loopMode === 'off' ? '↻' : (loopMode === 'one' ? '🔂' : '🔁') }}</text>
          </view>
          <!-- 宽屏（16:9 contain vs cover） -->
          <view class="ctrl-btn" @tap="toggleWide">
            <text>{{ wideMode ? '▣' : '▢' }}</text>
          </view>
          <!-- 音量 -->
          <view class="ctrl-btn" @tap="toggleMute">
            <text>{{ muted ? '🔇' : '🔊' }}</text>
          </view>
          <!-- 全屏 -->
          <view class="ctrl-btn" @tap="fullscreen ? onExitFullscreen() : onFullscreen()">
            <text>{{ fullscreen ? '✕' : '⛶' }}</text>
          </view>
        </view>
        <view
          class="progress-wrap"
          @touchstart.stop="onSeekTouchStart"
          @touchmove.stop.prevent="onSeekTouchMove"
          @touchend.stop.prevent="onSeekTouchEnd"
        >
          <view class="progress-bg" />
          <view class="progress-fill" :style="{ width: fillWidthPx + 'px' }" />
          <view class="progress-thumb" :style="{ left: thumbLeftPx + 'px' }" />
        </view>
        <!-- 倍速菜单弹层 -->
        <view v-if="speedMenuOpen" class="speed-menu" @tap.stop="noop">
          <view
            v-for="s in SPEEDS"
            :key="s"
            class="speed-item"
            :class="{ active: s === speed }"
            @tap="pickSpeed(s)"
          >
            <text>{{ s === 1 ? '1x (正常)' : s + 'x' }}</text>
          </view>
        </view>
      </view>
      <!-- 全屏顶部返回条 -->
      <view v-if="fullscreen" class="fs-top">
        <text class="fs-exit" @tap="onExitFullscreen">‹ 退出全屏</text>
        <text class="fs-title" lines="1">{{ video?.title }}</text>
      </view>
    </view>

    <!-- 第1行：简介 / 评论 切换 tab + 弹幕发送 + 弹幕开关（点击后下方组件切换，上方视频不动） -->
    <view class="detail-tabs">
      <view
        class="tab-item"
        :class="{ active: activeTab === 'intro' }"
        @tap="activeTab = 'intro'"
      ><text>简介</text></view>
      <view
        class="tab-item"
        :class="{ active: activeTab === 'comment' }"
        @tap="activeTab = 'comment'"
      ><text>评论 {{ video?.comment_count ? formatCount(video.comment_count) : '' }}</text></view>
      <view class="tab-spacer" />
      <input
        v-model="danmakuText"
        class="tab-dm-input"
        placeholder="发个弹幕"
        confirm-type="send"
        @confirm="sendDanmaku"
      />
      <view class="tab-dm-send" @tap="sendDanmaku"><text>发送</text></view>
      <view class="dm-toggle" :class="{ off: !dmVisible }" @tap="toggleDmVisible">
        <text>{{ dmVisible ? '✓弹' : '弹' }}</text>
      </view>
    </view>

    <!-- 简介视图（第2-5行 + 简介全文 + 相关推荐） -->
    <view v-if="activeTab === 'intro'">
    <!-- UP主卡片 -->
    <view v-if="video" class="up-card">
      <image class="avatar" :src="video.uploader_avatar_url || '/static/avatar/default.png'" mode="aspectFill" @tap="goSpace" />
      <view class="up-meta" @tap="goSpace">
        <view class="up-row">
          <text class="nickname">{{ video.uploader }}</text>
          <text class="fans">{{ formatCount(video.uploader_follower_count || 0) }}粉丝</text>
        </view>
        <text class="up-intro">共 {{ video.uploader_published_count || 0 }} 个视频</text>
      </view>
      <view class="follow-btn" @tap="onFollow">
        <text>{{ followed ? '已关注' : '+ 关注' }}</text>
      </view>
    </view>

    <!-- 标题 + 详细下拉（简介展开） -->
    <view v-if="video" class="title-section">
      <view class="title-row">
        <text class="v-title">{{ video.title }}</text>
        <text v-if="video.description" class="detail-toggle" @tap="expanded = !expanded">
          {{ expanded ? '收起 ⌃' : '详细 ⌄' }}
        </text>
      </view>
      <text v-if="video.description && expanded" class="v-desc">{{ video.description }}</text>
    </view>

    <!-- 数据行：播放量 / 弹幕量 / 日期 / 在线人数 -->
    <view v-if="video" class="stats-row">
      <text class="stat-item">▶ {{ formatCount(video.play_count) }}</text>
      <text class="stat-item">💬 {{ formatCount(video.danmaku_count) }}</text>
      <text class="stat-item">📅 {{ formatDate(video.created_at) }}</text>
      <text class="stat-item">🟢 {{ video.watching_count || 0 }} 人在线</text>
    </view>

    <!-- 操作按钮组：点赞 / 点踩 / 投币 / 收藏 / 转发 -->
    <view v-if="video" class="action-row">
      <view class="action-btn" @tap="onLike">
        <text class="action-icon">{{ video.liked_by_me ? '❤️' : '👍' }}</text>
        <text>{{ formatCount(video.like_count) }}</text>
      </view>
      <view class="action-btn" @tap="onDislike">
        <text class="action-icon">{{ disliked ? '👎' : '🤙' }}</text>
        <text>点踩</text>
      </view>
      <view class="action-btn" @tap="onCoin">
        <text class="action-icon">🪙</text>
        <text>投币{{ video.my_coin_amount > 0 ? ` (${video.my_coin_amount})` : '' }}</text>
      </view>
      <view class="action-btn" @tap="onFavorite">
        <text class="action-icon">{{ video.favorited_by_me ? '🌟' : '⭐' }}</text>
        <text>{{ formatCount(video.fav_count) }}</text>
      </view>
      <view class="action-btn" @tap="onShare">
        <text class="action-icon">↗</text>
        <text>转发</text>
      </view>
    </view>

    <!-- 视频合集导航（后端有合集数据时才显示，点击弹出视频列表） -->
    <view v-if="video && seriesList && seriesList.length > 0" class="series-bar" @tap="openSeries">
      <text class="series-title">合集 · {{ seriesTitle || '视频合集' }}</text>
      <text class="series-arrow">▾ 点击展开</text>
    </view>

    <!-- 相关推荐（简介视图底部） -->
    <view class="related">
      <text class="section-title">相关推荐</text>
      <view v-for="r in related" :key="r.id" class="related-card" @tap="loadDetail(r.id)">
        <image class="r-cover" :src="r.cover_url || '/static/placeholder.png'" mode="aspectFill" />
        <view class="r-meta">
          <text class="r-title" lines="2">{{ r.title }}</text>
          <text class="r-up">{{ r.uploader || '匿名' }}</text>
          <text class="r-stats">▶ {{ formatCount(r.play_count) }} · {{ formatDuration(r.duration) }}</text>
        </view>
      </view>
    </view>
    </view>
    <!-- /简介视图 -->

    <!-- 评论视图（评论区，点击"评论"tab 后显示，上方视频不动） -->
    <view v-if="activeTab === 'comment'">
    <!-- 评论区（两层：顶层 + 回复） -->
    <view class="comment-section">
      <view class="comment-head">
        <text class="section-title">评论 {{ video?.comment_count || 0 }}</text>
      </view>

      <view v-if="!isLoggedIn" class="login-tip" @tap="goLogin">
        <text>登录后参与评论 ›</text>
      </view>

      <view v-else class="comment-input-row">
        <input
          v-model="commentText"
          class="comment-input"
          placeholder="发一条友善的评论"
          confirm-type="send"
          @confirm="submitComment"
        />
        <view class="comment-send" @tap="submitComment">
          <text>发布</text>
        </view>
      </view>

      <view v-if="comments.length === 0 && !commentsLoading" class="empty-state">
        <text>💬 暂无评论，快来抢沙发</text>
      </view>

      <view v-for="c in topComments" :key="c.id" class="comment-item">
        <image class="c-avatar" :src="c.avatar_url || '/static/avatar/default.png'" mode="aspectFill" />
        <view class="c-body">
          <view class="c-row">
            <text class="c-name">{{ c.username }}</text>
            <text class="c-time">{{ formatTime(c.created_at) }}</text>
          </view>
          <text class="c-content">{{ c.content }}</text>
          <view class="c-actions">
            <text class="c-act" @tap="toggleCommentLike(c)">{{ c.liked_by_me ? '❤️' : '👍' }} {{ c.like_count || '' }}</text>
            <text class="c-act" @tap="replyTo(c)">回复</text>
            <template v-if="isUploader">
              <text class="c-act up-act" @tap="pinComment(c)">{{ c.pinned ? '取消置顶' : '置顶' }}</text>
              <text v-if="!c.comments_curated" class="c-act up-act" @tap="approveComment(c)">精选</text>
            </template>
          </view>
          <view v-if="repliesOf(c.id).length > 0" class="reply-box">
            <view v-for="r in (expandedReplies.has(c.id) ? repliesOf(c.id) : repliesOf(c.id).slice(0, 3))" :key="r.id" class="reply-item">
              <text class="reply-name">{{ r.username }}：</text>
              <text class="reply-content">{{ r.content }}</text>
            </view>
            <text v-if="repliesOf(c.id).length > 3" class="expand-replies" @tap="toggleReplies(c.id)">
              {{ expandedReplies.has(c.id) ? '收起回复' : `展开 ${repliesOf(c.id).length - 3} 条回复` }} ▾
            </text>
          </view>
        </view>
      </view>

      <view v-if="hasMoreComments" class="load-more" @tap="loadMoreComments">
        <text>加载更多评论</text>
      </view>
    </view>
    </view>
    <!-- /评论视图 -->
  </view>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { onLoad, onReady, onUnload, onBackPress } from '@dcloudio/uni-app'
import { videoApi } from '@/api/video'
import type { Comment, Video } from '@/utils/types'

// ⚠️ nvue 运行在 weex 引擎，Pinia 的 defineStore 不可用（编译产物 Fn.defineStore 未定义导致白屏）
// 登录态/用户信息从本地 storage 读取（与 request.ts 拿 token 的方式一致）
const accessToken = ref<string>((uni.getStorageSync('access_token') || '') as string)
const localUser = ref<{ user_id?: number } | null>(uni.getStorageSync('user') || null)
const isLoggedIn = computed(() => !!accessToken.value)

const video = ref<Video | null>(null)
const related = ref<Video[]>([])
const loading = ref(false)
const expanded = ref(false)
const followed = ref(false)
const disliked = ref(false) // 点踩（后端暂无 dislike 接口，先本地态）
const seriesList = ref<unknown[]>([]) // 合集（后端暂无接口，预留条件渲染）
const seriesTitle = ref('')
const activeTab = ref<'intro' | 'comment'>('intro') // 简介/评论 切换
let currentId = 0

const sys = uni.getSystemInfoSync()
const screenW = sys.windowWidth || 390
const screenH = sys.windowHeight || 664
const statusBarH = sys.statusBarHeight || 20
const playerH = Math.round((screenW * 9) / 16)

// 播放地址 baseURL：与 request.ts 同款条件编译（App 端必须用局域网 IP，不能 127.0.0.1）
// #ifdef APP-PLUS
const baseURL = import.meta.env.VITE_API_BASE_URL_APP || 'http://192.168.1.100:8080'
// #endif
// #ifndef APP-PLUS
// 注意：H5 dev 的 VITE_API_BASE_URL 为空，必须 fallback 127.0.0.1:8080（vite dev 不代理 /uploads）
const baseURL = import.meta.env.VITE_API_BASE_URL || 'http://127.0.0.1:8080'
// #endif
const playUrl = computed(() => {
  if (!video.value?.video_url) return ''
  const u = video.value.video_url
  return u.startsWith('http') ? u : baseURL + u
})

// ===== 弹幕引擎（nvue 原生 view 模拟，canvas 在 nvue 有 API 差异故弃用） =====
interface DmTimelineItem {
  content: string
  color: string
  type: string
  font_size: string
  video_time: number
}
interface DmViewItem {
  id: number
  text: string
  color: string
  type: string
  fontSize: number
  x: number
  y: number
  speed: number
  born: number
  duration: number
}

const dmList = ref<DmTimelineItem[]>([])
const dmItems = ref<DmViewItem[]>([])
const danmakuText = ref('')
let dmIdx = 0
let dmTimer: ReturnType<typeof setInterval> | null = null
let dmTrackCursor = 0
let dmIdSeq = 1
let dmWidth = screenW
let dmHeight = playerH
const DM_FPS = 30
const DM_TRAVEL_SEC = 8

function fontSizePx(fs: string): number {
  const base = Math.max(12, Math.round(dmWidth / 27))
  if (fs === 'sm') return base - 2
  if (fs === 'lg') return base + 4
  return base
}

function dmTrackCount(): number {
  return Math.max(2, Math.floor((dmHeight * 0.82) / (fontSizePx('md') + 8)))
}

function dmTextWidth(text: string, fs: number): number {
  let w = 0
  for (const ch of text) {
    w += ch.charCodeAt(0) > 255 ? fs : fs * 0.55
  }
  return w
}

async function loadDanmakus() {
  dmList.value = []
  dmIdx = 0
  dmItems.value = []
  if (!currentId) return
  try {
    const resp = await videoApi.danmakus(currentId, 0, 2000)
    dmList.value = resp.items.map((i) => ({
      content: i.content,
      color: i.color,
      type: i.type,
      font_size: i.font_size,
      video_time: i.video_time
    }))
  } catch {
    /* 弹幕拉取失败不阻塞播放 */
  }
}

function spawnDm(item: DmTimelineItem, now: number) {
  const fs = fontSizePx(item.font_size)
  const isScroll = item.type !== 'top' && item.type !== 'bottom'
  if (isScroll) {
    const speed = dmWidth / DM_TRAVEL_SEC
    dmTrackCursor = (dmTrackCursor + 1) % dmTrackCount()
    const y = dmTrackCursor * (fs + 8) + fs
    dmItems.value.push({
      id: dmIdSeq++, text: item.content, color: item.color || '#FFFFFF', type: 'scroll',
      fontSize: fs, x: dmWidth, y, speed, born: now, duration: 0
    })
  } else {
    const y = item.type === 'top' ? fs + 4 : dmHeight - fs - 6
    dmItems.value.push({
      id: dmIdSeq++, text: item.content, color: item.color || '#FFFFFF', type: item.type,
      fontSize: fs, x: dmWidth / 2, y, speed: 0, born: now, duration: 3.5
    })
  }
}

function tickDm() {
  const t = currentTime.value
  while (dmIdx < dmList.value.length && dmList.value[dmIdx].video_time <= t) {
    spawnDm(dmList.value[dmIdx], t)
    dmIdx++
  }
  const keep: DmViewItem[] = []
  for (const d of dmItems.value) {
    if (d.type === 'scroll') {
      d.x -= d.speed / DM_FPS
      if (d.x + dmTextWidth(d.text, d.fontSize) < 0) continue
    } else if (t - d.born > d.duration) {
      continue
    }
    keep.push(d)
  }
  dmItems.value = keep
}

function startDm() {
  stopDm()
  if (!dmList.value.length) return
  dmTimer = setInterval(tickDm, 1000 / DM_FPS)
}

function stopDm() {
  if (dmTimer) {
    clearInterval(dmTimer)
    dmTimer = null
  }
}

function resetDm() {
  dmItems.value = []
  dmIdx = 0
}

// ===== 应用内全屏（客户端：fixed 铺满 + 锁横屏，弹幕 view 跟随容器） =====
const fullscreen = ref(false)

function lockOrientation(lock: boolean) {
  try {
    if (lock) (plus as any).screen.lockOrientation('landscape-primary')
    else (plus as any).screen.unlockOrientation()
  } catch (_) { /* 部分 ROM 不支持 */ }
  try {
    if (lock) (plus as any).navigator.setFullscreen(true)
    else (plus as any).navigator.setFullscreen(false)
  } catch (_) { /* 忽略 */ }
}

function onFullscreen() {
  fullscreen.value = true
  seekRect = null // 布局变化，进度条 rect 需重新查询
  lockOrientation(true)
  setTimeout(() => {
    refreshDmSize()
    resetDm()
  }, 200)
}

function onExitFullscreen() {
  fullscreen.value = false
  seekRect = null // 布局变化，进度条 rect 需重新查询
  lockOrientation(false)
  setTimeout(() => {
    refreshDmSize()
    resetDm()
  }, 200)
}

onBackPress(() => {
  if (fullscreen.value) {
    onExitFullscreen()
    return true
  }
  return false
})

function refreshDmSize() {
  uni
    .createSelectorQuery()
    .select('.player')
    .boundingClientRect((rect: any) => {
      if (rect && rect.width > 0) {
        dmWidth = Math.round(rect.width)
        dmHeight = Math.round(rect.height)
      }
    })
    .exec()
}

// ===== 页面生命周期 =====
onLoad((q) => {
  currentId = Number(q?.id) || 0
  loadDetail(currentId)
})

onReady(() => {
  refreshDmSize()
})

onUnload(() => {
  stopDm()
  stopTimePoll()
})

async function loadDetail(id: number) {
  currentId = id
  loading.value = true
  video.value = null
  comments.value = []
  commentCursor = null
  stopDm()
  try {
    const [v, rels] = await Promise.all([
      videoApi.detail(id),
      videoApi.list(undefined, 50)
    ])
    video.value = v
    followed.value = v.followed_by_me
    // 时长直接取后端字段（nvue weex 的 loadedmetadata/timeupdate 事件可能不触发，不能依赖）
    duration.value = v.duration || 0
    related.value = rels.items.filter((r) => r.id !== id).slice(0, 8)
    loadComments()
    loadDanmakus()
  } finally {
    loading.value = false
  }
}

// ===== 评论 =====
const comments = ref<Comment[]>([])
const commentsLoading = ref(false)
const commentText = ref('')
const hasMoreComments = ref(false)
let commentCursor: string | null = null
let replyParentId: number | null = null

async function loadComments() {
  if (!currentId || commentsLoading.value) return
  commentsLoading.value = true
  try {
    const resp = await videoApi.comments(currentId, commentCursor ?? undefined)
    comments.value.push(...resp.items)
    const tops = resp.items.filter((c: Comment) => !c.parent_id)
    if (tops.length) {
      commentCursor = String(tops[tops.length - 1].id)
    } else if (!resp.items.length) {
      commentCursor = null
    }
    hasMoreComments.value = !!commentCursor
  } catch { /* 已 toast */ }
  finally { commentsLoading.value = false }
}

const topComments = computed(() => comments.value.filter((c) => !c.parent_id || c.parent_id === 0))

function repliesOf(parentId: number): Comment[] {
  return comments.value.filter((c) => c.parent_id === parentId)
}

const expandedReplies = ref<Set<number>>(new Set())
function toggleReplies(parentId: number) {
  const s = new Set(expandedReplies.value)
  if (s.has(parentId)) s.delete(parentId)
  else s.add(parentId)
  expandedReplies.value = s
}

async function loadMoreComments() {
  if (!commentCursor) return
  await loadComments()
}

async function submitComment() {
  const content = commentText.value.trim()
  if (!content) {
    uni.showToast({ title: '请输入评论内容', icon: 'none' })
    return
  }
  try {
    const resp = await videoApi.createComment(currentId, content, replyParentId ?? undefined)
    uni.showToast({ title: resp.approved ? '评论成功' : '评论待审核', icon: 'success' })
    commentText.value = ''
    replyParentId = null
    comments.value = []
    commentCursor = null
    await loadComments()
  } catch { /* 已 toast */ }
}

function replyTo(c: Comment) {
  replyParentId = c.parent_id || c.id
  commentText.value = `回复 @${c.username}：`
}

function toggleCommentLike(c: Comment) {
  c.liked_by_me = !c.liked_by_me
  c.like_count += c.liked_by_me ? 1 : -1
  uni.showToast({ title: c.liked_by_me ? '已点赞' : '已取消', icon: 'none' })
}

async function pinComment(c: Comment) {
  try {
    await videoApi.pinComment(c.id)
    c.pinned = !c.pinned
    uni.showToast({ title: c.pinned ? '已置顶' : '已取消置顶', icon: 'success' })
  } catch (e) {
    uni.showToast({ title: (e as Error).message || '置顶失败（需UP主）', icon: 'none' })
  }
}

async function approveComment(c: Comment) {
  try {
    await videoApi.approveComment(c.id)
    c.comments_curated = true
    uni.showToast({ title: '已设为精选', icon: 'success' })
  } catch (e) {
    uni.showToast({ title: (e as Error).message || '精选失败（需UP主）', icon: 'none' })
  }
}

// ===== 弹幕发送 =====
async function sendDanmaku() {
  const content = danmakuText.value.trim()
  if (!content) {
    uni.showToast({ title: '请输入弹幕', icon: 'none' })
    return
  }
  if (!isLoggedIn.value) {
    uni.showToast({ title: '请先登录', icon: 'none' })
    return
  }
  try {
    await videoApi.sendDanmaku(currentId, { content, video_time: Math.floor(currentTime) || 0 })
    uni.showToast({ title: '弹幕已发送', icon: 'success' })
    danmakuText.value = ''
    dmList.value.push({
      content,
      color: '#FFFFFF',
      type: 'scroll',
      font_size: 'md',
      video_time: Math.floor(currentTime) || 0
    })
    if (playing.value) spawnDm(dmList.value[dmList.value.length - 1], currentTime.value)
  } catch { /* 已 toast */ }
}

// ===== 互动 =====
async function onLike() {
  if (!video.value) return
  if (!isLoggedIn.value) { goLogin(); return }
  try {
    const r = await videoApi.toggleLike(video.value.id)
    video.value.liked_by_me = r.liked
    video.value.like_count = r.count
  } catch { /* 已 toast */ }
}

async function onCoin() {
  if (!video.value) return
  if (!isLoggedIn.value) { goLogin(); return }
  try {
    const r = await videoApi.coin(video.value.id)
    video.value.my_coin_amount = r.my_coin_amount
    video.value.coin_count = r.coin_count
    video.value.coined_by_me = r.coined
    uni.showToast({ title: `投币成功！剩余硬币 ${r.coin_balance}`, icon: 'success' })
  } catch { /* 已 toast */ }
}

async function onFavorite() {
  if (!video.value) return
  if (!isLoggedIn.value) { goLogin(); return }
  try {
    const r = await videoApi.toggleFavorite(video.value.id)
    video.value.favorited_by_me = r.favorited
    video.value.fav_count = r.fav_count
    uni.showToast({ title: r.favorited ? '已收藏' : '已取消收藏', icon: 'success' })
  } catch { /* 已 toast */ }
}

function onShare() { uni.showToast({ title: '分享功能待完善', icon: 'none' }) }

/** 点踩：后端暂无接口，先本地切换 */
function onDislike() {
  disliked.value = !disliked.value
  uni.showToast({ title: disliked.value ? '已点踩' : '已取消点踩', icon: 'none' })
}

/** 合集展开：后端暂无合集接口，预留 */
function openSeries() {
  uni.showToast({ title: '合集功能待接入', icon: 'none' })
}

const isUploader = computed(() => !!video.value && isLoggedIn.value && localUser.value?.user_id === video.value.user_id)

// ===== 播放器状态 =====
const playing = ref(false)
const userStarted = ref(false)
const currentTime = ref(0)
const duration = ref(0)
const speed = ref(1)
// SPEEDS 已在下方 PC 端功能增强区块声明(6 档:0.5/1/1.25/1.5/2/3),避免重复声明
const controlsVisible = ref(true)
const muted = ref(false)
let controlsTimer: ReturnType<typeof setTimeout> | null = null

/** 显示控制条并 3 秒后自动隐藏（B 站风格） */
function showControls() {
  controlsVisible.value = true
  if (controlsTimer) clearTimeout(controlsTimer)
  controlsTimer = setTimeout(() => { controlsVisible.value = false }, 3000)
}
/** 点击播放器：切换控制条显示/隐藏 */
function toggleControls() {
  if (controlsVisible.value) {
    controlsVisible.value = false
    if (controlsTimer) { clearTimeout(controlsTimer); controlsTimer = null }
  } else {
    showControls()
  }
}

// ===== 播放器手势（B 站风格）：单击 = 唤出/隐藏控制条；双击 = 播放/暂停 =====
let lastPlayerTap = 0
let playerTapTimer: ReturnType<typeof setTimeout> | null = null

function onPlayerTap() {
  const now = Date.now()
  console.log('[nvue-gesture] tap now=', now, 'last=', lastPlayerTap)
  if (now - lastPlayerTap < 300) {
    // 双击 → 播放/暂停
    if (playerTapTimer) { clearTimeout(playerTapTimer); playerTapTimer = null }
    lastPlayerTap = 0
    console.log('[nvue-gesture] DOUBLE TAP → togglePlay')
    onTogglePlay()
    return
  }
  lastPlayerTap = now
  // 单击延迟 300ms 执行（等可能的双击），唤出/隐藏控制条
  if (playerTapTimer) clearTimeout(playerTapTimer)
  playerTapTimer = setTimeout(() => {
    playerTapTimer = null
    lastPlayerTap = 0
    console.log('[nvue-gesture] SINGLE TAP → toggleControls')
    toggleControls()
  }, 300)
}
/** 静音切换（nvue video context 支持 mute） */
function onMute() {
  const ctx = getVideoContext()
  if (!ctx) return
  muted.value = !muted.value
  try {
    ;(ctx as any).mute?.(muted.value)
  } catch { /* weex 部分版本无 mute */ }
}

function onLoadedMeta(e: any) {
  // 兼容 vue/weex 不同事件格式：e.detail.duration / e.duration / e.target.duration
  duration.value = e?.detail?.duration || e?.duration || e?.target?.duration || 0
  // 加载完成显示控制条并启动 3 秒自动隐藏（避免黑条常驻）
  showControls()
}

function onTimeUpdate(e: any) {
  // 拖动进度条时忽略 timeupdate，避免 thumb 被拉回
  if (dragging.value) return
  // 兼容 vue/weex 格式：e.detail.currentTime / e.currentTime / e.target.currentTime
  const t = e?.detail?.currentTime ?? e?.currentTime ?? e?.target?.currentTime
  if (typeof t === 'number' && isFinite(t)) {
    currentTime.value = t
    simClock = t // 同步模拟时钟
  }
  const d = e?.detail?.duration ?? e?.duration ?? e?.target?.duration
  if (d && !duration.value) duration.value = d
}

function onPlay() { playing.value = true; startDm(); showControls() }
function onPause() { playing.value = false; stopDm(); showControls() }
function onEnded() {
  playing.value = false
  stopTimePoll()
  stopDm()
  // 单曲循环：回到开头并自动播放
  if (loopMode.value === 'one') {
    resetSimClock(0)
    resetDm()
    setTimeout(() => {
      playing.value = true
      getVideoContext()?.seek(0)
      getVideoContext()?.play()
      startTimePoll()
      startDm()
    }, 200)
  } else {
    resetDm()
  }
  showControls()
}

// 播放/暂停切换防抖锁：双击判定可能因事件重复/时序触发多次，500ms 内只执行一次
let toggleLock = 0
// 播放时间轮询：nvue weex 的 @timeupdate 事件可能不触发、VideoContext 无 getCurrentTime，
// 用 JS 模拟时钟推进（播放中每 500ms +0.5s），seek/暂停/恢复时重置
let timePollTimer: ReturnType<typeof setInterval> | null = null
let simClock = 0
let lastSimTick = 0

function startTimePoll() {
  if (timePollTimer) return
  lastSimTick = Date.now()
  timePollTimer = setInterval(() => {
    const now = Date.now()
    if (!dragging.value) {
      simClock += (now - lastSimTick) / 1000
      currentTime.value = Math.min(simClock, duration.value || simClock)
    }
    lastSimTick = now
  }, 500)
}

function stopTimePoll() {
  if (timePollTimer) { clearInterval(timePollTimer); timePollTimer = null }
}

function resetSimClock(t: number) {
  simClock = t
  currentTime.value = t
}

function onTogglePlay() {
  const now = Date.now()
  if (now - toggleLock < 500) return
  toggleLock = now
  userStarted.value = true
  const ctx = getVideoContext()
  if (!ctx) return
  try {
    if (playing.value) {
      playing.value = false // 乐观更新：weex @pause 事件可能不触发，先同步界面
      stopTimePoll()
      ctx.pause()
    } else {
      playing.value = true
      startTimePoll()
      ctx.play()
    }
    showControls()
  } catch { /* 忽略 */ }
}

// ===== 进度条拖动（touch 事件，nvue/weex 原生支持） =====
// 注：进度条只绑 touch 三件套，不绑 @tap——拖完松手 weex 会派发 tap，用错误比例覆盖 seek 结果
const dragging = ref(false)
let seekRect: { left: number; width: number } | null = null

/** 获取 progress-wrap 自身 rect（不能用 e.target：touch 可能落在 thumb/fill 子元素上导致 left 偏移） */
function ensureSeekRect() {
  if (seekRect) return
  try {
    uni.createSelectorQuery().select('.progress-wrap').boundingClientRect((rect: any) => {
      if (rect && rect.width > 0) seekRect = { left: rect.left, width: rect.width }
    }).exec()
  } catch { /* 忽略 */ }
}

function ratioFromTouch(e: any): number {
  const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  if (!t) return -1
  if (seekRect && seekRect.width > 0) {
    // 轨道起点 = wrap 左缘 + 14rpx padding；轨道宽度 = wrap 宽 - 两侧 padding（与 fill/thumb 定位一致）
    const trackLeft = seekRect.left + barPadPx
    const trackW = seekRect.width - barPadPx * 2
    if (trackW <= 0) return -1
    return Math.min(1, Math.max(0, (t.pageX - trackLeft) / trackW))
  }
  // 兜底：seekRect 尚未异步就绪（首次触摸）时，用布局常量同步估算
  // 轨道起点 = controls padding(16rpx) + wrap padding(14rpx)，宽度 = barTrackW
  const startX = (16 * screenW) / 750 + barPadPx
  if (barTrackW <= 0) return -1
  return Math.min(1, Math.max(0, (t.pageX - startX) / barTrackW))
}

function onSeekTouchStart(e: any) {
  if (!duration.value) return
  dragging.value = true
  ensureSeekRect()
  const r = ratioFromTouch(e)
  if (r >= 0) currentTime.value = r * duration.value
}

function onSeekTouchMove(e: any) {
  if (!dragging.value) return
  ensureSeekRect()
  const r = ratioFromTouch(e)
  if (r >= 0) currentTime.value = r * duration.value
}

function onSeekTouchEnd(e: any) {
  if (!dragging.value) return
  dragging.value = false
  // 保留 seekRect 缓存：拖动/点击进度条位置不变，避免下次重新异步查询导致首次触摸不跟手
  const r = ratioFromTouch(e)
  if (r >= 0) {
    const target = r * duration.value
    resetSimClock(target)
    getVideoContext()?.seek(target)
    resetDm()
  }
}

function onCycleSpeed() {
  // 兼容旧入口：循环切换（保留旧行为）
  const idx = SPEEDS.indexOf(speed.value)
  speed.value = SPEEDS[(idx + 1) % SPEEDS.length]
  getVideoContext()?.playbackRate(speed.value)
}

// ===== PC 端功能增强（nvue）：弹幕开关 / 倍速菜单 / 循环 / 宽屏 / 音量 =====
const SPEEDS = [0.5, 1, 1.25, 1.5, 2, 3]
const speedLabel = computed(() => (speed.value === 1 ? '1x' : speed.value + 'x'))
const speedMenuOpen = ref(false)
function openSpeedMenu() {
  speedMenuOpen.value = !speedMenuOpen.value
  showControls() // 打开弹层时阻止自动隐藏
}
function pickSpeed(s: number) {
  speed.value = s
  speedMenuOpen.value = false
  try { getVideoContext()?.playbackRate(s) } catch { /* ignore */ }
}

const dmVisible = ref(true)
function toggleDmVisible() {
  dmVisible.value = !dmVisible.value
  // 关闭弹幕时停掉 timer + 清掉屏幕上现有弹幕
  if (!dmVisible.value) { stopDm(); dmItems.value = [] } else if (playing.value) { startDm() }
}

const loopMode = ref<'off' | 'one' | 'all'>('off')  // 关 / 单曲循环 / 全部循环
function toggleLoop() {
  loopMode.value = loopMode.value === 'off' ? 'one' : loopMode.value === 'one' ? 'all' : 'off'
}

const wideMode = ref(false)  // false=contain(默认) / true=cover(宽屏,裁剪填满)
function toggleWide() {
  wideMode.value = !wideMode.value
  // 通过 inline style 覆盖 video 的 object-fit
  try {
    const ctx = getVideoContext() as any
    if (ctx && ctx.videoEl) ctx.videoEl.style.objectFit = wideMode.value ? 'cover' : 'contain'
  } catch { /* nvue 原生 video 不一定支持运行时改 objectFit,忽略 */ }
}

const volume = ref(1.0)  // 0-1
function setVolume(v: number) {
  volume.value = Math.max(0, Math.min(1, v))
  muted.value = volume.value === 0
  try { (getVideoContext() as any)?.volume?.(volume.value) } catch { /* ignore */ }
}
function toggleMute() {
  if (muted.value) {
    // 取消静音:恢复上次音量
    if (volume.value === 0) volume.value = 1
    setVolume(volume.value)
  } else {
    setVolume(0)
  }
}
// 滑块变更（nvue 暂用按钮式 0/0.5/1.0 切换,真正的 slider 需要 renderjs 较复杂）
function cycleVolume() {
  const levels = [0, 0.5, 1.0]
  const idx = levels.findIndex((v) => Math.abs(v - volume.value) < 0.01)
  const next = levels[(idx + 1) % levels.length]
  setVolume(next)
}

function getVideoContext(): UniApp.VideoContext | null {
  if (!video.value) return null
  return uni.createVideoContext('vd-' + video.value.id)
}

const progressPct = computed(() => {
  // 兜底：duration/currentTime 非法时返回 0，避免 NaN% 导致 nvue 渲染 controls 失败
  const d = duration.value
  const t = currentTime.value
  if (!d || !isFinite(d) || d <= 0 || !isFinite(t) || t < 0) return 0
  const pct = (t / d) * 100
  if (!isFinite(pct)) return 0
  // 保留小数：拖动时按像素平滑跟随，不用 round 跳格
  return Math.min(100, Math.max(0, pct))
})

// ===== 进度条布局（weex 绝对定位 % 不可靠，全部换算成显式 px） =====
const ctrlPadPx = ((16 * screenW) / 750) * 2   // .controls padding 16rpx 左右
const barPadPx = (14 * screenW) / 750           // .progress-wrap padding 14rpx
const barTrackW = screenW - ctrlPadPx - barPadPx * 2 // 轨道实际宽度 px
const thumbHalfPx = (18 * screenW) / 750        // thumb 半径（36rpx/2）
/** fill 宽度 px：轨道宽 × 百分比 */
const fillWidthPx = computed(() => (barTrackW * progressPct.value) / 100)
/** thumb left px：相对 progress-wrap，轨道起点 + 进度 - 半径（圆心对准进度位置） */
const thumbLeftPx = computed(() => barPadPx + (barTrackW * progressPct.value) / 100 - thumbHalfPx)

// ===== 工具 =====
function noop() {}
function formatClock(sec: number): string {
  if (!sec || Number.isNaN(sec)) return '00:00'
  const m = Math.floor(sec / 60)
  const s = Math.floor(sec % 60)
  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
}
function formatDuration(s: number): string {
  if (!s) return ''
  const m = Math.floor(s / 60)
  const sec = (s % 60).toString().padStart(2, '0')
  return `${m}:${sec}`
}
function formatCount(n: number): string {
  if (n >= 10000) return `${(n / 10000).toFixed(1)}万`
  return n.toString()
}
function formatTime(s: string): string {
  if (!s) return ''
  const d = new Date(s)
  const diff = (Date.now() - d.getTime()) / 1000
  if (diff < 3600) return `${Math.floor(diff / 60)}分钟前`
  if (diff < 86400) return `${Math.floor(diff / 3600)}小时前`
  return `${d.getFullYear()}-${(d.getMonth() + 1).toString().padStart(2, '0')}-${d.getDate().toString().padStart(2, '0')}`
}
/** 发布日期（数据行用，与 formatTime 同逻辑） */
function formatDate(s: string): string {
  if (!s) return ''
  const d = new Date(s)
  if (isNaN(d.getTime())) return ''
  return `${d.getFullYear()}-${(d.getMonth() + 1).toString().padStart(2, '0')}-${d.getDate().toString().padStart(2, '0')}`
}
function onMore() { uni.showToast({ title: '更多操作待完善', icon: 'none' }) }
function goBack() { uni.navigateBack() }
function goLogin() { uni.navigateTo({ url: '/pages/login/index' }) }
function goSpace() {
  if (video.value) uni.navigateTo({ url: `/pages/space/index?id=${video.value.user_id}` })
}
function onFollow() { followed.value = !followed.value }
</script>

<style lang="scss" scoped>
/* nvue 规范：flex 布局、扁平 class、无伪元素/嵌套选择器 */
.page {
  min-height: 100vh;
  background: #FFF;
  padding-bottom: 60rpx;
}

.navbar {
  display: flex;
  flex-direction: row; /* weex 默认 column */
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
}
.nav-back { width: 60rpx; font-size: 48rpx; color: #181818; }
.nav-title { flex: 1; font-size: 30rpx; font-weight: 500; padding: 0 16rpx; color: #181818; }
.nav-more { width: 60rpx; font-size: 32rpx; text-align: right; color: #181818; }

.player {
  position: relative;
  width: 100%;
  background: #000;
}
.player-fs {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}
.video-el {
  width: 100%;
  height: 100%;
}

.dm-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  /* 弹幕层只显示不拦截触摸（点击视频区域必须穿透到 touch-layer） */
  pointer-events: none;
}
/* 透明触摸层：接收单击/双击手势，层级在 video 之上、封面/控制条之下 */
.touch-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: transparent;
  z-index: 2;
}
.dm-item {
  position: absolute;
  left: 0;
  top: 0;
}

.cover {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* B 站风格：透明背景，不遮挡视频画面（原 rgba(0,0,0,0.35) 会压暗半个视频） */
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3; /* 高于 touch-layer(2)，未播放时拦截单击=播放 */
}
.play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #FB7299;
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.cover-tip {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 16rpx;
}

.controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 16rpx 8rpx;
  /* B 站风格底部渐变：底部半透明黑 → 顶部全透明，不再整条黑底遮挡画面 */
  background-image: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  z-index: 4; /* 高于 touch-layer(2)，按钮/进度条优先接收触摸 */
}
.ctrl-row {
  display: flex;
  flex-direction: row; /* weex 默认 column */
  align-items: center;
  color: #FFF;
}
.ctrl-btn {
  min-width: 44rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFF;
}
.ctrl-time { font-size: 22rpx; color: rgba(255, 255, 255, 0.9); margin-left: 20rpx; }
.spacer { flex: 1; }
.progress-wrap {
  position: relative;
  height: 36rpx; /* 加高到与 thumb 同高，thumb 垂直居中无需 % */
  margin-top: 2rpx;
  /* 左右留出圆点半径空间：0% 进度时圆点依然在屏内可见 */
  padding-left: 14rpx;
  padding-right: 14rpx;
  display: flex;
  align-items: center;
}
.progress-bg {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 15rpx; /* (36-6)/2 显式居中 */
